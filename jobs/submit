universe              = vanilla
executable            = master.sh
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
arguments             = $(ifile) $(output_base)
transfer_input_files  = cmssw.tgz, run_ntuplizer.sh
transfer_output_files = ""
request_cpus          = 1
request_memory        = 8 GB
request_disk          = 12 GB
output                = logs/submit.$(ClusterId).$(ProcId).out
error                 = logs/submit.$(ClusterId).$(ProcId).err
log                   = logs/submit.$(ClusterId).log
use_x509userproxy      = True
x509userproxy         = $(proxy_path)
+JobFlavour           = "workday"
queue ifile from files_2016H.txt
